{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@t3n-aca/core": ["packages/core/src/index.ts"],
      "@t3n-aca/core/*": ["packages/core/src/*"],
      "@t3n-aca/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@t3n-aca/policy-engine/*": ["packages/policy-engine/src/*"],
      "@t3n-aca/t3n": ["packages/t3n/src/index.ts"],
      "@t3n-aca/t3n/*": ["packages/t3n/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  // capture-screenshots.ts imports playwright, which is deliberately NOT a
  // dependency of this project — it is heavy, and only needed when someone
  // regenerates the README gallery. The script documents how to install it
  // temporarily. Excluded so `npm run verify` does not require it.
  "exclude": ["node_modules", "dist", "**/dist", "scripts/capture-screenshots.ts"]
}
